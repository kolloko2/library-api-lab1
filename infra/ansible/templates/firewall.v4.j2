*filter
:INPUT DROP [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -p tcp -s 10.0.2.2/32 --dport 22 -j ACCEPT
-A INPUT -p tcp -s 192.168.77.10/32 --dport 22 -j ACCEPT
{% if inventory_hostname in groups['database'] %}
-A INPUT -p tcp -s 192.168.77.10/32 --dport 5432 -j ACCEPT
{% else %}
-A INPUT -p tcp --dport 8000 -j ACCEPT
{% endif %}
COMMIT
