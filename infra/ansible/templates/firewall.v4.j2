*filter
:LIBRARY_MANAGED - [0:0]
-F LIBRARY_MANAGED
-A LIBRARY_MANAGED -i lo -j ACCEPT
-A LIBRARY_MANAGED -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A LIBRARY_MANAGED -p tcp -s 10.0.2.2/32 --dport 22 -j ACCEPT
-A LIBRARY_MANAGED -p tcp -s {{ library_app_ip }}/32 --dport 22 -j ACCEPT
{% if inventory_hostname in groups['database'] %}
-A LIBRARY_MANAGED -p tcp -s {{ library_app_ip }}/32 --dport 5432 -j ACCEPT
{% else %}
-A LIBRARY_MANAGED -p tcp --dport 8000 -j ACCEPT
{% endif %}
-A LIBRARY_MANAGED -j DROP
COMMIT
